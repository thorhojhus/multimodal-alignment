	author = {Li, Zhiqi and Chen, Guo and Liu, Shilong and Wang, Shihao and VS, Vibashan and Ji, Yishen and Lan, Shiyi and Zhang, Hao and Zhao, Yilin and Radhakrishnan, Subhashree and Chang, Nadine and Sapra, Karan and Deshmukh, Amala Sanjay and Rintamaki, Tuomas and Le, Matthieu and Karmanov, Ilia and Voegtle, Lukas and Fischer, Philipp and Huang, De-An and Roman, Timo and Lu, Tong and Alvarez, Jose M. and Catanzaro, Bryan and Kautz, Jan and Tao, Andrew and Liu, Guilin and Yu, Zhiding},
	month = jan,
