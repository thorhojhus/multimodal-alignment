	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Machine Learning},
	file = {Preprint PDF:/Users/thorh/Zotero/storage/KRLFKCXY/Radford et al. - 2021 - Learning Transferable Visual Models From Natural Language Supervision.pdf:application/pdf;Snapshot:/Users/thorh/Zotero/storage/HWXTIUXE/2103.html:text/html},
