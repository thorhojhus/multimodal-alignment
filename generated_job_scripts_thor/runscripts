#!/bin/bash
# Now only run scripts with job number > 10

for script in generated_job_scripts_thor/job_*.sh; do
    if [ -f "$script" ]; then
        idx=${script##*job_}
        idx=${idx%.sh}
        if [[ "$idx" =~ ^[0-9]+$ ]] && [ "$idx" -gt 10 ]; then
            echo "Submitting $script ..."
            bsub < "$script"
        fi
    fi
done